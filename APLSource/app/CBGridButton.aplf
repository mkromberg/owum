 grid CBGridButton args;val;cc;parent;leaf;cols;i;desc;obj;p;which;sf
 leaf←2⊃pluck⊃args
 (cc val cols)←grid eWG'CurCell' 'Values' 'ColTitles'
 :If (≢cols)<i←cols⍳⊂'Beskrivelse'
     →0⊣DisplayPopup 'Fejl' 'Beskrivelse mangler' 'Error' 'OK'
 :EndIf
 desc←⊃val[cc[1];i]

 :Select leaf
 :Case 'DEL'
     which←2⊃pluck sf←1⊃pluck grid
     :Select which
     :Case 'Dok'
         :If 1=desc DisplayPopup 'Bekræft sletning'('Vil du slette filen "%1" ?')'Warn'('OK' 'Cancel')
             1 ⎕NDELETE ROOT,'/Documents/',desc
             DOCS←ReadDocs ROOT,'/Documents/'
             MakeDokGrid sf
             desc DisplayPopup 'Fil Slettet'('Filen "%1 er slettet.')'Info' 'OK'
         :EndIf
     :EndSelect
 :EndSelect
