 CBTop args;ctl;lix
 ⍝ Log Out, Change Password, or select language
 ⍝ (buttons on the top line of the form)

 ctl←⊃⌽'.'(≠⊆⊢)⊃args
 :Select ctl
 :Case 'LOGOUT'
     DisplayPopup'' 'Tak for denne gang!' 'Info' 'OK'
     USERID←''
     MakeLogin

 :Case 'NEWPWD'
     eNQ 'F1.TC.DivTB' 'Select' ⍝ Redirect user to the Diverse (Misc) Tab

 :Else
     :If 'FLAG_'≡5↑ctl          ⍝ Clicked on a flag to change language
     :AndIf (≢LANGUAGES)≥lix←LANGUAGES⍳⊂¯2↑ctl
         SelectLanguage lix
         MakeMain
         eNQ ACTIVESF 'Select'
     :EndIf
 :EndSelect
