 MakeLogin;image;bcol;USERID;background;formcss;rows;user;lang
⍝ Create Login form

 image←'/Resources/images/ae-wide-frame.jpg'
 bcol←219 252 252 ⍝ Pale blue
 USERID←'' ⍝ Global state

 background←'background-image: url("',image,'"), background-size: contain, background-position: center, background-repeat: no-repeat'
 formcss←background,', flex-direction: row, align-items: center, justify-content: center'
 rows←'flex-direction: row, flex-wrap: wrap, justify-content: space-between, gap: 5px, align-items: flex-start'

 'F1'eWC'Form' 'Please Login'('Coord' 'Pixel')('Flex' 'fill')('BCol'bcol)('CSS' formcss)
 2 eNQ 'F1' 'SetTitle' APPNAME

 'F1.INPUT'eWC'SubForm'('Flex' 'row')('CSS' 'margin-top: 66vh; justify-content: center;')
 'F1.INPUT.CREDS'eWC'SubForm'('Flex' 'row')('CSS'rows)('BCol'bcol)

 user←1 2⊃(2 eNQ 'F1' 'GetCookie' 'OWUMUSER'),⊂'' ''
 lang←1 2⊃(2 eNQ 'F1' 'GetCookie' 'OWUMLANGUAGE'),⊂'' ''

 LANGUAGE←(LANGUAGES⍳⊂lang)⊃(1+≢LANGUAGES)⍴LANGUAGES
 SelectLanguage LANGUAGE

 'F1.INPUT.CREDS.USERID' 'User ID'LabelAbove'Edit' user('Size'(23 150))
 'F1.INPUT.CREDS.PWD' 'Passord'LabelAbove'Edit' ''('Size'(23 100))('Password' '*')

 'F1.INPUT.CREDS.BTNS'eWC'SubForm'('Flex' 'column')
 'F1.INPUT.CREDS.BTNS.LOGIN'eWC'Button' (T 'Login')('Size'(23 120))('Default' 1)('Event' 'Select' 'CBLogin')
 'F1.INPUT.CREDS.BTNS.FORGOT'eWC'Button' (T 'Glemt passord')('Size'(23 120))('Default' 0)('Event' 'Select' 'CBLogin')

 eNQ'F1.INPUT.CREDS.USERID' 'GotFocus'
